{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Classic Win Games",
  "version": "0.1.0",
  "identifier": "com.jschell.classic-win-games",
  "build": {
    "beforeBuildCommand": "node tools/build-desktop.mjs",
    "beforeDevCommand": "node tools/build-desktop.mjs",
    "frontendDist": "../build/desktop-web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{
      "label": "main",
      "create": false,
      "title": "Classic Win Games",
      "width": 1100,
      "height": 850,
      "minWidth": 375,
      "minHeight": 500,
      "dragDropEnabled": false,
      "useHttpsScheme": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "../icons/icon-192.png"]
  }
}
